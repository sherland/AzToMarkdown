<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>AzToMarkdown.Tests</AssemblyName>
    <RootNamespace>AzToMarkdown.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzResourceDetails.Templating\AzResourceDetails.Templating.csproj" />
    <!-- Core reference — needed for AzToMarkdown unit tests -->
    <ProjectReference Include="..\..\src\Libraries\AzToMarkdown.Core\AzToMarkdown.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real captured ARM payloads used by PortalExampleFixtureTests — docs/portal-examples/
         stays the single source of truth; nothing here duplicates the JSON inline. -->
    <None Include="..\..\docs\portal-examples\**\data.json" Link="TestData\PortalExamples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
