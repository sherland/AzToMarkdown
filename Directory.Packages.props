<Project>
  <PropertyGroup>
    <!-- Byte-identical synchronized projects keep their authoritative package declarations. -->
    <ManagePackageVersionsCentrally Condition="'$(MSBuildProjectName)' != 'AzResourceDetails.Templating' and '$(MSBuildProjectName)' != 'AzResourceDetails.Templating.Tests'">true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Scriban" Version="7.4.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.12" />
    <PackageVersion Include="CliWrap" Version="3.10.5" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>