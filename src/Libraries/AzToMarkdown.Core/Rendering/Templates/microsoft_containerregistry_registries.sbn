{{-
  sku          = model.props.sku ? model.props.sku.name : null
  login_server = model.props.loginserver
  extra_fm     = ""
  if sku
    extra_fm = "sku: " + sku
  end
  if login_server
    extra_fm = extra_fm + (extra_fm != "" ? "\n" : "") + "login_server: " + login_server
  end
-}}
